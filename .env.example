# ==========================================
# Neffto Solution - Backend Environment Variables Template
# ==========================================

# Server Port
PORT=5000

# Admin Panel Security Key
ADMIN_PASSWORD=your_secure_admin_password_here

# Email / Nodemailer SMTP Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_TO=recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Frontend & Admin URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# (Optional) MongoDB Connection String
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/neffto?retryWrites=true&w=majority

# Cloudinary Cloud Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
